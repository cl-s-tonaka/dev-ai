# Google OAuth Credentials
# credentials.jsonのパス（Google Cloud Consoleからダウンロード）
GOOGLE_CREDENTIALS_PATH=~/.config/google-workspace-mcp/credentials.json

# トークン保存先のパス
GOOGLE_TOKEN_PATH=~/.config/google-workspace-mcp/token.json

# OAuth リダイレクトURI（デフォルト: localhost）
OAUTH_REDIRECT_URI=http://localhost:3000/oauth2callback

# デバッグモード
DEBUG=false
