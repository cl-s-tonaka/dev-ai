# BrowserStack Credentials
BROWSERSTACK_USERNAME=your_username
BROWSERSTACK_ACCESS_KEY=your_access_key

# Media Injection Settings
# true/false で各機能の有効・無効を切り替え
ENABLE_CAMERA_INJECTION=false
ENABLE_AUDIO_INJECTION=false

# Media URLs (obtained from upload-media.js output)
CAMERA_MEDIA_URL=media://xxxxxxxx
AUDIO_MEDIA_URL=media://xxxxxxxx
